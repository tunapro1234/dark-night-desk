# Weekly re-read of First Avenue's public calendar into data/venues (scripts/refresh-venues.js).
# Started by dark-night-desk-refresh.timer. Not installed by the repo; to install both units:
#   cp deploy/dark-night-desk-refresh.service deploy/dark-night-desk-refresh.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now dark-night-desk-refresh.timer
# The running server reads venue files on every request, so it needs no restart after a refresh.
[Unit]
Description=Dark Night Desk calendar refresh (First Avenue month pages)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/lighthouse/hackathon-coz/projeler/devpost-qloo-agentic/kod/dark-night-desk
# Node 22 or newer; change the path if node lives elsewhere (`which node`).
ExecStart=/usr/bin/node scripts/refresh-venues.js
Environment=NODE_ENV=production
# Same file as the server, so VENUES_DIR and DATA_DIR match; the refresh itself needs no key.
EnvironmentFile=/srv/lighthouse/hackathon-coz/projeler/devpost-qloo-agentic/secrets/dnd.env
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Writes VENUES_DIR (venue files) and DATA_DIR/raw-calendar (raw pages); keep these equal to dnd.env if it moves them.
ReadWritePaths=/srv/lighthouse/hackathon-coz/projeler/devpost-qloo-agentic/kod/dark-night-desk/data/venues -/srv/lighthouse/hackathon-coz/projeler/devpost-qloo-agentic/kod/dark-night-desk/var
