# Runs dark-night-desk-refresh.service once a week. Not installed by the repo (see the service file).
[Unit]
Description=Weekly Dark Night Desk calendar refresh

[Timer]
# Monday 06:30 in the server's local time zone, plus up to 20 minutes of random delay.
OnCalendar=Mon *-*-* 06:30:00
RandomizedDelaySec=20m
# A run missed while the machine was off starts at the next boot.
Persistent=true
Unit=dark-night-desk-refresh.service

[Install]
WantedBy=timers.target
